{
  "$schema": "../gen/schemas/desktop-schema.json",
  "identifier": "nodepilot-main",
  "description": "NodePilot main window capabilities",
  "windows": ["main"],
  "permissions": [
    "core:default",
    "core:path:default",
    "core:event:default",
    "core:window:default",
    "core:app:default",
    "core:resources:default",
    "core:menu:default",
    "core:tray:default",
    "opener:default",
    "fs:default",
    "fs:allow-read-text-file",
    "fs:allow-write-text-file",
    "fs:allow-read-dir",
    "fs:allow-mkdir",
    "fs:allow-exists",
    "process:default",
    "http:default",
    "http:allow-fetch",
    "shell:allow-execute",
    "shell:allow-open"
  ]
}
